#!/bin/bash
# Average battery discharge in watts over N seconds (default 60).
secs=${1:-60}
[[ $(cat /sys/class/power_supply/ACAD/online) == 1 ]] && echo "On AC: unplug first for a real reading" && exit 1
sum=0
for ((i = 0; i < secs; i++)); do
    sum=$((sum + $(cat /sys/class/power_supply/BAT0/power_now)))
    sleep 1
done
awk -v s="$sum" -v n="$secs" 'BEGIN { printf "%.1f W average over %d s\n", s / n / 1e6, n }'
